  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.383.0"
  },
  "devDependencies": {
    "vite": "5.4.0",
    "@vitejs/plugin-react": "4.3.1"
  }
}
