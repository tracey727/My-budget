{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genevieve-budget",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/ready"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "40061acf4dd74d808860c06fe9c2f075"
    }
  ]
}
